//        First Script

using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.EventSystems;

public class FindClick : MonoBehaviour, IPointerDownHandler
{
    [SerializeField] private GameObject otherDifference;

    private void Start()
    {
        string p = gameObject.name.Substring(0, gameObject.name.IndexOf('_'));
        if (gameObject.name.Contains("_1")) otherDifference = GameObject.Find(p + "_2");
        else otherDifference = GameObject.Find(p + "_1");
    }
    public void OnPointerDown(PointerEventData eventData)
    {
        GetComponent<SpriteRenderer>().enabled = true;
        GetComponent<FindClick>().enabled = false;
        otherDifference.GetComponent<SpriteRenderer>().enabled = true;
        otherDifference.GetComponent<SpriteRenderer>().enabled = true;
    }
}

//        Second Script

using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UIElements;
using UnityEngine.SceneManagement;

public class FindingDifferenceManager : MonoBehaviour
{
    [SerializeField] private UIDocument ui;
    [SerializeField] private VisualTreeAsset gameControl;
    [SerializeField] private Sprite[] settingsSprite;
    [SerializeField] private GameObject[] FindingDifference;
    int differenceNumber;
    void Start()
    {
        Camera.main.backgroundColor = new Color(Random.Range(0, 1.1f), Random.Range(0, 1.1f), Random.Range(0, 1.1f), 255);

        GameObject p = Instantiate(FindingDifference[Random.Range(0, FindingDifference.Length)]);
        SceneManager.MoveGameObjectToScene(p, SceneManager.GetSceneByName(MainMenu.modeName));

        ui = GetComponent<UIDocument>();
        ui.rootVisualElement.Q<Label>("DifferenceNumber").style.display = DisplayStyle.Flex;
        differenceNumber = GameObject.FindGameObjectsWithTag("Difference").Length / 2;
        ui.rootVisualElement.Q<Label>("DifferenceNumber").text = "Kalan Fark : " + differenceNumber;
        ui.rootVisualElement.Q<Button>("UnloadPuzzle").RegisterCallback<ClickEvent>(Unload);
    }

    public void FindDifference()
    {
        differenceNumber--;
        ui.rootVisualElement.Q<Label>("DifferenceNumber").text = "Kalan Fark : " + differenceNumber;
        if (differenceNumber == 0) Invoke(nameof(Congratulations), 1);
    }

    public void Congratulations()
    {
        ui.rootVisualElement.Q<Label>("Congratulations").style.display = DisplayStyle.Flex;
    }

    public void Unload(ClickEvent e)
    {
        GameObject.Find("GameStartManager").GetComponent<UIDocument>().visualTreeAsset = gameControl;
        GameObject.Find("GameStartManager").GetComponent<UIDocument>().rootVisualElement.Q<Button>("Settings").style.backgroundImage = new StyleBackground(settingsSprite[MainMenu.t]);
        GameObject.Find("GameStartManager").GetComponent<UIDocument>().rootVisualElement.Q<Button>("Settings").RegisterCallback<ClickEvent>(GameObject.Find("GameStartManager").GetComponent<GameStartManager>().EnterSettings);
        ChestOpening.isTrigger = false;
        GameStartManager.mainCamera.GetComponent<Camera>().enabled = true;
        GameStartManager.joyStick.SetActive(true);
        GameStartManager.jump.SetActive(true);
        SceneManager.UnloadSceneAsync(MainMenu.modeName);
    }
}
